{
  "name": "grain-gradient",
  "version": "2.0.0",
  "description": "Lightweight WebGL shader utilities for mesh and grain gradients.",
  "keywords": [
    "background",
    "gradient",
    "grain",
    "react",
    "shader",
    "webgl"
  ],
  "homepage": "https://github.com/aomona/grain-gradient#readme",
  "bugs": {
    "url": "https://github.com/aomona/grain-gradient/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aomona/grain-gradient.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./webgl": {
      "types": "./dist/webgl.d.ts",
      "import": "./dist/webgl.js"
    },
    "./webgl/react": {
      "types": "./dist/webgl-react.d.ts",
      "import": "./dist/webgl-react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vite",
    "build:playground": "vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p playground/tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "playground": "vite --open"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "react-dom": "^19.2.7",
    "typescript": "^5.5.4",
    "vite": "^8.0.14"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
