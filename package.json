{
  "name": "grain-gradient",
  "version": "0.1.0",
  "description": "Lightweight TypeScript utilities for mesh and grain gradients.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aomona/grain-gradient.git"
  },
  "bugs": {
    "url": "https://github.com/aomona/grain-gradient/issues"
  },
  "homepage": "https://github.com/aomona/grain-gradient#readme",
  "keywords": [
    "gradient",
    "grain",
    "svg",
    "background",
    "react"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "typescript": "^5.5.4"
  }
}
